generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Service {
  id           String        @id @default(cuid())
  name         String
  category     String
  description  String
  durationMin  Int
  bufferMin    Int           @default(15)
  price        Int
  discountPrice Int?          // Precio promocional opcional (si existe, price se tacha)
  depositPrice  Int?          // Seña fija opcional en ARS (si es null, aplica 30%)
  isActive     Boolean       @default(true)
  appointments Appointment[]
}

model Client {
  id           String        @id @default(cuid())
  phone        String        @unique // Formato normalizado: 54911XXXXXXXX
  name         String
  techNotes    String?       // Ficha técnica persistente (bigudí, tiempos, pigmento, bebida favorita)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  appointments Appointment[]
}

model Appointment {
  id          String   @id @default(cuid())
  manageToken String?  @unique
  clientName  String
  clientPhone String
  clientNotes String?
  techNotes   String?
  startTime   DateTime
  endTime     DateTime
  status      String   @default("PENDING") // PENDING | CONFIRMED | COMPLETED | CANCELLED
  serviceId   String
  service     Service  @relation(fields: [serviceId], references: [id])
  clientId    String?
  client      Client?  @relation(fields: [clientId], references: [id])
  createdAt   DateTime @default(now())
}

model WorkingHours {
  id        Int     @id @default(autoincrement())
  dayOfWeek Int     @unique // 0 = Domingo ... 6 = Sábado
  startTime String
  endTime   String
  isOpen    Boolean @default(true)
}

model BlockedSlot {
  id        String   @id @default(cuid())
  startTime DateTime
  endTime   DateTime
  reason    String?
}
